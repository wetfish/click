FROM docker.io/node:24.22.1-alpine AS npm

COPY ./public_html/package.json /public_html/package.json

RUN set -exu \
  && cd /public_html \
  && npm install

# runtime container
FROM docker.io/nginx:1.30.6-alpine

# nginx serves the static files, and checks php files exist before passing them on
COPY ./public_html /var/www
# only ship wetfish-basic's built js, not all of node_modules
COPY --from=npm /public_html/node_modules/wetfish-basic/dist /var/www/node_modules/wetfish-basic/dist
COPY ./config/nginx.conf /etc/nginx/conf.d/default.conf

# taken from nginx dockerfile here
# https://github.com/nginxinc/docker-nginx/blob/fef51235521d1cdf8b05d8cb1378a526d2abf421/stable/alpine/Dockerfile
ENTRYPOINT ["/docker-entrypoint.sh"]
EXPOSE 80
STOPSIGNAL SIGQUIT
CMD ["nginx", "-g", "daemon off;"]
